<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient">

    <!-- ═══════════════════════════════════════════════════════════
         LOADING STATE
         ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutTrackLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent_yellow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_regular_font"
            android:text="Loading ride..."
            android:textColor="@color/text_white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         ACCESS DENIED STATE
         ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutAccessDenied"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserrat_bold_font"
            android:gravity="center"
            android:text="Access Denied"
            android:textColor="@color/text_white"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_regular_font"
            android:gravity="center"
            android:text="This ride is not active or you don't have access to it."
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTrackGoBackDenied"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_yellow_rounded"
            android:fontFamily="@font/montserrat_semibold_font"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Go Back"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         MAIN CONTENT (mapa + sidebar)
         ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutTrackContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header: ruta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_purple_dark_tint"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <!-- Back button -->
            <ImageView
                android:id="@+id/btnTrackGoBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Go back"
                android:src="@drawable/ic_back"
                app:tint="@color/text_white" />

            <!-- Route text -->
            <TextView
                android:id="@+id/tvTrackRoute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/montserrat_semibold_font"
                android:maxLines="1"
                android:text="Pickup → Destination"
                android:textColor="@color/text_white"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Mapa (zauzima najveći deo ekrana) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webViewTrackMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Live indicator (pulsiranje • Ride is live) -->
        <LinearLayout
            android:id="@+id/layoutLiveIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_purple_dark_tint"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- Pulsing dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/montserrat_semibold_font"
                android:text="Ride is live"
                android:textColor="#2ECC71"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="#2ECC71"
                android:alpha="0.5" />
        </LinearLayout>

        <!-- Ride Ended overlay (unutar content) -->
        <LinearLayout
            android:id="@+id/layoutRideEnded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC1A1A2E"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏁"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/montserrat_bold_font"
                android:text="Ride Completed"
                android:textColor="@color/text_white"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserrat_regular_font"
                android:text="The driver has ended this ride."
                android:textColor="@color/text_gray"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom details panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_purple_dark_tint"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ETA + Cena -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- ETA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular_font"
                        android:text="ETA"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp"
                        android:textAllCaps="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTrackEta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold_font"
                            android:text="—"
                            android:textColor="@color/text_white"
                            android:textSize="20sp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/text_gray"
                    android:alpha="0.4"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <!-- Cena -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular_font"
                        android:text="Current Price"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tvTrackCurrentPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold_font"
                        android:text="—"
                        android:textColor="@color/accent_yellow"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_gray"
                android:alpha="0.3"
                android:layout_marginBottom="12dp" />

            <!-- Start time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:text="Start time"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTrackStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold_font"
                    android:text="—"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/text_gray"
                android:alpha="0.3"
                android:layout_marginBottom="12dp" />

            <!-- Person info (Driver ili Passenger) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_purple_tint"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <!-- Avatar -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_user_placeholder"
                    android:contentDescription="Person"
                    app:tint="@color/text_white"/>

                <!-- Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTrackPersonLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular_font"
                        android:text="Driver"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTrackPersonName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_semibold_font"
                        android:text="—"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvTrackPersonPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular_font"
                        android:text=""
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Report Inconsistency dugme (samo za putnike) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReportInconsistency"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_purple_tint"
                android:fontFamily="@font/montserrat_semibold_font"
                android:text="Report Inconsistency"
                android:textAllCaps="false"
                android:textColor="@color/accent_yellow"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>