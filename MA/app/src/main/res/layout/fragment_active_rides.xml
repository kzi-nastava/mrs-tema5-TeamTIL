<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold_font"
            android:text="Active Rides"
            android:textColor="@color/text_white"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/montserrat_regular_font"
            android:text="All currently active rides"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- SEARCH BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:alpha="0.5"
                android:contentDescription="Search"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/montserrat_regular_font"
                android:hint="Search by driver name..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_white"
                android:textColorHint="#5a4e6a"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivClearSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:alpha="0.6"
                android:contentDescription="Clear search"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Auto-refresh toggle -->
        <LinearLayout
            android:id="@+id/llRefreshToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_refresh_toggle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivRefreshIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Auto refresh"
                android:src="@drawable/ic_refresh" />

            <TextView
                android:id="@+id/tvRefreshState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/montserrat_bold_font"
                android:text="ON"
                android:textColor="@color/accent_yellow"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- COUNT META ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvRidesCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_semibold_font"
            android:letterSpacing="0.05"
            android:text="ACTIVE RIDES (0)"
            android:textAllCaps="true"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/pbLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/accent_yellow"
            android:visibility="gone" />
    </LinearLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.2"
        android:background="#3d2b4a" />

    <!-- CONTENT: RecyclerView or Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RIDES LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvActiveRides"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:visibility="gone" />

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/llEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.4"
                android:contentDescription="No rides"
                android:src="@drawable/ic_car_empty" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/montserrat_semibold_font"
                android:gravity="center"
                android:text="No active rides at the moment."
                android:textColor="#5a4e6a"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- INITIAL LOADING -->
        <ProgressBar
            android:id="@+id/pbInitialLoad"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_yellow"
            android:visibility="visible" />

    </FrameLayout>

    <!-- BOTTOM DETAIL PANEL (slides up when ride selected) -->
    <LinearLayout
        android:id="@+id/layoutDetailPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_detail_panel"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Panel Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold_font"
                android:text="Ride Details"
                android:textColor="@color/text_white"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/ivClosePanel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:alpha="0.7"
                android:contentDescription="Close panel"
                android:src="@drawable/ic_close_ic" />
        </LinearLayout>

        <!-- Driver Row in panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivPanelDriverAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="Driver"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPanelDriverName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold_font"
                    android:text="Driver Name"
                    android:textColor="@color/text_white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPanelDriverPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:text="+381 60 000 0000"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Rating"
                    android:src="@drawable/ic_star_filled2" />

                <TextView
                    android:id="@+id/tvPanelRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/montserrat_bold_font"
                    android:text="4.9"
                    android:textColor="@color/accent_yellow"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="@color/text_gray"
            android:layout_marginBottom="12dp"/>

        <!-- Vehicle + Time + Distance row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:text="Vehicle"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPanelVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold_font"
                    android:text="Toyota Corolla"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPanelLicensePlate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:text="NS-000-AA"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:text="Distance"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPanelDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold_font"
                    android:text="5.2 km"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:text="ETA"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPanelEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold_font"
                    android:text="15:30"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:background="@color/text_gray"
            android:layout_marginBottom="12dp"/>

        <!-- Passenger Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_regular_font"
            android:text="Passenger"
            android:textColor="@color/text_gray"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/ivPanelPassengerAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="Passenger"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPanelPassengerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold_font"
                    android:text="Passenger Name"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPanelPassengerPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:text="+381 60 111 1111"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- View Full Details Button (only IN_PROGRESS) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewFullDetails"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/button_yellow_rounded"
            android:fontFamily="@font/montserrat_bold_font"
            android:text="View Full Ride Details"
            android:textAllCaps="false"
            android:textColor="#1a0d22"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>