<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_purple_dark_tint"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- ROW 1: Ruta + zvezdica -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvRoute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_semibold_font"
            android:text="Polazište → Odredište" />

        <!-- ZVEZDICA ZA FAVORITE -->
        <ImageView
            android:id="@+id/ivFavoriteStar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_star_outline2"
            android:contentDescription="Favorite"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/accent_yellow" />
    </LinearLayout>

    <!-- ROW 2: Status + Panic badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:fontFamily="@font/montserrat_semibold_font"
            android:textColor="@color/text_white"
            android:background="@drawable/bg_status_completed"
            android:text="Completed" />

        <TextView
            android:id="@+id/tvPanicBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="10sp"
            android:fontFamily="@font/montserrat_semibold_font"
            android:textColor="@color/text_white"
            android:background="#CC0000"
            android:text="⚠ PANIC"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ROW 3: Datum + Cijena -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:fontFamily="@font/montserrat_regular_font"
            android:text="01 Jan 2026, 10:00" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_yellow"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_semibold_font"
            android:text="1.200 RSD" />
    </LinearLayout>

</LinearLayout>
