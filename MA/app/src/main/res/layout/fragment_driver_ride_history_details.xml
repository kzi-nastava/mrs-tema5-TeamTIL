<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- HEADING -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_semibold_font"
                android:text="@string/ride_details_heading"
                android:textColor="@color/text_white"
                android:textSize="32sp" />

            <!-- ADDRESS -->
            <TextView
                android:id="@+id/tvRideAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_location"
                android:drawableTint="@color/white"
                android:drawablePadding="4dp"
                android:fontFamily="@font/montserrat_semibold_font"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"/>

            <!-- MAP -->
            <WebView
                android:id="@+id/webViewRideMap"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="12dp" />

            <!-- ── DETAILS CARD ──────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_purple_dark_tint"
                android:layout_marginBottom="10dp">

                <!-- PASSENGERS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Passengers"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:fontFamily="@font/montserrat_semibold_font"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/passengersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp"/>

                <!-- TIMES / DURATION / DISTANCE -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/text_gray"
                    android:alpha="0.3"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start time"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_semibold_font"/>
                        <TextView
                            android:id="@+id/tvStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_regular_font"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End time"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_semibold_font"/>
                        <TextView
                            android:id="@+id/tvEndTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_regular_font"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/text_gray"
                        android:alpha="0.4"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duration"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_semibold_font"/>
                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_regular_font"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Distance"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_semibold_font"/>
                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_white"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_regular_font"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- PRICE + STATUS -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/text_gray"
                    android:alpha="0.3"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_semibold_font"/>
                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:fontFamily="@font/montserrat_semibold_font"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRideStatus"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white"
                        android:fontFamily="@font/montserrat_semibold_font"
                        android:textSize="13sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── RATING SECTION (read-only) ─────────────────────────────── -->
            <LinearLayout
                android:id="@+id/ratingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_purple_dark_tint"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ride Rating"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:fontFamily="@font/montserrat_semibold_font"/>

                    <TextView
                        android:id="@+id/tvRatingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unrated"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:fontFamily="@font/montserrat_semibold_font"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/badge_grey"/>
                </LinearLayout>

                <!-- Stars -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <ImageView android:id="@+id/ratingStar1"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:padding="2dp" android:src="@drawable/ic_star_empty"/>
                    <ImageView android:id="@+id/ratingStar2"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:padding="2dp" android:src="@drawable/ic_star_empty"/>
                    <ImageView android:id="@+id/ratingStar3"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:padding="2dp" android:src="@drawable/ic_star_empty"/>
                    <ImageView android:id="@+id/ratingStar4"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:padding="2dp" android:src="@drawable/ic_star_empty"/>
                    <ImageView android:id="@+id/ratingStar5"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:padding="2dp" android:src="@drawable/ic_star_empty"/>
                </LinearLayout>

                <!-- Comment -->
                <TextView
                    android:id="@+id/tvRatingComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#d0c8da"
                    android:textSize="13sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:textStyle="italic"
                    android:background="@drawable/bg_purple_tint"
                    android:padding="10dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- ── ISSUES SECTION (read-only) ─────────────────────────────── -->
            <LinearLayout
                android:id="@+id/issuesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_purple_dark_tint"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inconsistency Reports"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:fontFamily="@font/montserrat_semibold_font"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvNoIssues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No inconsistency reports for this ride."
                    android:textColor="@color/text_gray"
                    android:textSize="13sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:visibility="visible"/>

                <LinearLayout
                    android:id="@+id/issuesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>