<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚨 Panic Notifications"
        android:textColor="@color/text_white"
        android:textSize="28sp"
        android:fontFamily="@font/montserrat_semibold_font"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Review and handle panic alerts"
        android:textColor="@color/text_gray"
        android:textSize="13sp"
        android:fontFamily="@font/montserrat_regular_font"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:id="@+id/panicLoadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvNoPanics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No panic alerts at the moment"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPanicList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

</LinearLayout>

