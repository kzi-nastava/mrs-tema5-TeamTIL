<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <EditText
        android:id="@+id/etPickupAddress"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/pickup_address"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="12dp"
        android:inputType="text"/>

    <EditText
        android:id="@+id/etDestinationAddress"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/destination_address"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="12dp"
        android:inputType="text"/>

    <Button
        android:id="@+id/btnEstimate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/estimate_ride"
        android:textColor="@android:color/white"
        android:background="@color/purple_main"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnRequestRide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/request_a_ride"
        android:textColor="@android:color/white"
        android:background="@android:color/holo_blue_dark"
        android:layout_marginTop="8dp"/>

</LinearLayout>

