<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Ride booking"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_semibold_font" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_clear"
            android:contentDescription="Close"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FF4444" />
    </LinearLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3A2D5C"
        android:layout_marginBottom="8dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- ===== LOCATION INPUTS ===== -->
            <!-- START LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_purple_tint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_location_circle"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:fontFamily="@font/montserrat_semibold_font" />

                <EditText
                    android:id="@+id/etStartLocation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Add starting location"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionNext" />
            </LinearLayout>

            <!-- STOPS CONTAINER -->
            <LinearLayout
                android:id="@+id/llStopsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ADD STOP BUTTON -->
            <LinearLayout
                android:id="@+id/btnAddStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_purple_tint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_location_circle"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:fontFamily="@font/montserrat_semibold_font" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Add stop"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font" />
            </LinearLayout>

            <!-- END LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_purple_tint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_location_circle_end"
                    android:gravity="center"
                    android:text="E"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:fontFamily="@font/montserrat_semibold_font" />

                <EditText
                    android:id="@+id/etEndLocation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Add ending location"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionDone" />
            </LinearLayout>

            <!-- ===== DATE & TIME ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- DATE PICKER -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose date"
                        android:textColor="@color/accent_yellow"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_semibold_font"
                        android:layout_marginBottom="8dp" />

                    <!-- Calendar header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_purple_dark_tint"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/btnPrevMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&lt;"
                                android:textColor="@color/text_white"
                                android:textSize="16sp"
                                android:paddingEnd="8dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tvCurrentMonth"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="February 2026"
                                android:textColor="@color/accent_yellow"
                                android:textSize="13sp"
                                android:fontFamily="@font/montserrat_semibold_font" />

                            <TextView
                                android:id="@+id/btnNextMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&gt;"
                                android:textColor="@color/text_white"
                                android:textSize="16sp"
                                android:paddingStart="8dp"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Day grid -->
                        <GridLayout
                            android:id="@+id/calendarGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="7"
                            android:rowCount="7" />
                    </LinearLayout>
                </LinearLayout>

                <!-- TIME PICKER -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter time"
                        android:textColor="@color/accent_yellow"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_semibold_font"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_purple_dark_tint"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <!-- Minus row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/btnHourMinus"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_purple_tint"
                                android:gravity="center"
                                android:text="−"
                                android:textColor="@color/text_white"
                                android:textSize="18sp"
                                android:clickable="true"
                                android:focusable="true" />

                            <View
                                android:layout_width="24dp"
                                android:layout_height="0dp" />

                            <TextView
                                android:id="@+id/btnMinuteMinus"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_purple_tint"
                                android:gravity="center"
                                android:text="−"
                                android:textColor="@color/text_white"
                                android:textSize="18sp"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Time display -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/tvHour"
                                android:layout_width="48dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="12"
                                android:textColor="@color/text_white"
                                android:textSize="28sp"
                                android:fontFamily="@font/montserrat_semibold_font" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=":"
                                android:textColor="@color/text_white"
                                android:textSize="28sp"
                                android:fontFamily="@font/montserrat_semibold_font" />

                            <TextView
                                android:id="@+id/tvMinute"
                                android:layout_width="48dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="00"
                                android:textColor="@color/text_white"
                                android:textSize="28sp"
                                android:fontFamily="@font/montserrat_semibold_font" />
                        </LinearLayout>

                        <!-- Plus row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btnHourPlus"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/confirm_button_background"
                                android:gravity="center"
                                android:text="+"
                                android:textColor="@color/text_dark"
                                android:textSize="18sp"
                                android:clickable="true"
                                android:focusable="true" />

                            <View
                                android:layout_width="24dp"
                                android:layout_height="0dp" />

                            <TextView
                                android:id="@+id/btnMinutePlus"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/confirm_button_background"
                                android:gravity="center"
                                android:text="+"
                                android:textColor="@color/text_dark"
                                android:textSize="18sp"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A2D5C"
                android:layout_marginBottom="12dp"/>

            <!-- ===== FAVORITE ROUTES ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/btnToggleFavorites"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select from Favorite Routes"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font" />

                <TextView
                    android:id="@+id/tvFavoritesArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Favorite routes list (collapsed by default) -->
            <LinearLayout
                android:id="@+id/llFavoritesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A2D5C"
                android:layout_marginBottom="16dp"/>

            <!-- ===== INVITE PASSENGERS ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invite passengers"
                android:textColor="@color/accent_yellow"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_semibold_font"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_purple_tint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_location_circle"
                    android:gravity="center"
                    android:text="@"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etPassengerEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Enter email address"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/btnAddPassenger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/accent_yellow"
                    android:textSize="24sp"
                    android:paddingStart="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Added passengers list -->
            <LinearLayout
                android:id="@+id/llPassengersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3A2D5C"
                android:layout_marginBottom="16dp"/>

            <!-- ===== VEHICLE TYPE ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle Type"
                android:textColor="@color/accent_yellow"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_semibold_font"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/btnVehicleStandard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_vehicle_type_selected"
                    android:gravity="center"
                    android:text="Standard"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_semibold_font"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnVehicleLuxury"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_vehicle_type_unselected"
                    android:gravity="center"
                    android:text="Luxury"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnVehicleVan"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vehicle_type_unselected"
                    android:gravity="center"
                    android:text="Van"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- BABY / PET FRIENDLY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <CheckBox
                    android:id="@+id/cbBabyFriendly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Baby Friendly"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:buttonTint="@color/accent_yellow"
                    android:layout_marginEnd="24dp" />

                <CheckBox
                    android:id="@+id/cbPetFriendly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pet Friendly"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_regular_font"
                    android:buttonTint="@color/accent_yellow" />
            </LinearLayout>

            <!-- ===== REQUEST RIDE BUTTON ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestRide"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Request ride"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat_semibold_font"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_yellow"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
